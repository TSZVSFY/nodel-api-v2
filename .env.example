# ============================================
# Novel API - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# --- Server ---
PORT=35550

# --- MySQL Database ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_your_password_here
DB_NAME=novel

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=change_this_to_a_random_string

# --- Email (SMTP) ---
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_auth_code

# --- Tencent COS (File Upload) ---
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
